# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Password reset email (Gmail: use an App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
MAIL_FROM="Smart Hostel <your-email@gmail.com>"
# Leave SMTP_USER / SMTP_PASS empty in local development to send a preview email instead.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_hostel
DB_USER=root
DB_PASSWORD=12345
